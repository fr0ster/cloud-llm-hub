_schema-version: '3.3.0'
ID: cloud-llm-hub-deploy
extends: cloud-llm-hub
version: 1.0.0

parameters:
  # LLM Model Configuration
  LLM_AGENT_MODEL: "anthropic--claude-4.5-sonnet"
  LLM_AGENT_TEMPERATURE: "0.7"
  LLM_AGENT_MAX_TOKENS: "32000"

  # MCP Configuration
  LLM_AGENT_MCP_DESTINATION: "S4HANA_E19"

  # SmartAgent Configuration
  LLM_AGENT_MODE: "smart"
  LLM_AGENT_MAX_ITERATIONS: "10"
  LLM_AGENT_RAG_TYPE: "in-memory"

  # Classifier model
  LLM_AGENT_CLASSIFIER_MODEL: "gpt-4o-mini"

  # Embedding model for RAG semantic search
  LLM_AGENT_EMBEDDING_MODEL: "text-embedding-3-small"

  # Presentation model
  LLM_AGENT_PRESENTATION_MODEL: "gemini-2.5-flash"

  LLM_AGENT_EXPOSITION: "readonly,high"

  # Approuter route host
  APPROUTER_HOST: "epam-sap-mcp-450kjhsb-cloud-llm-hub"

  # AI Core credentials (no service binding on this subaccount)
  AICORE_AUTH_URL: "https://ai-applications-6efrmk2a.authentication.eu10.hana.ondemand.com"
  AICORE_CLIENT_ID: "sb-55f3a69b-66d5-4bad-8e55-4781fe9fd909!b274860|aicore!b540"
  AICORE_CLIENT_SECRET: "f689c147-52b4-4761-b703-c30c3ffb39fc$8ZGQy8mqOYOnc36UsTGfr5TzCxH609xw9h163Z-knDQ="
  AICORE_BASE_URL: "https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com"

# AI Core resource stays inactive (no binding)
