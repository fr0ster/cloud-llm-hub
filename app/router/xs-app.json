{
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/logout",
    "logoutPage": "/chat/webapp/logged-out.html"
  },
  "routes": [
    {
      "source": "^/chat/webapp/logged-out\\.html$",
      "target": "/chat/webapp/logged-out.html",
      "localDir": ".",
      "authenticationType": "none"
    },
    {
      "source": "^/v1/(.*)$",
      "target": "/v1/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/mcp/(.*)$",
      "target": "/mcp/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/chat/webapp/(.*)$",
      "target": "/chat/webapp/$1",
      "localDir": ".",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    }
  ]
}
