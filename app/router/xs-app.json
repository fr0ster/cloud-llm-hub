{
  "routes": [
    {
      "source": "^/v1/(.*)$",
      "target": "/v1/$1",
      "destination": "srv-api",
      "csrfProtection": false
    },
    {
      "source": "^/mcp/(.*)$",
      "target": "/mcp/$1",
      "destination": "srv-api",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "csrfProtection": true
    }
  ]
}
