_schema-version: "3.3.0"
ID: cloud-llm-hub.config
extends: cloud-llm-hub

modules:
  - name: cloud-llm-hub-srv
    parameters:
      env:
        # LLM Configuration
        LLM_AGENT_MODEL: "gpt-4o"  # or gpt-4o-mini, claude-3-5-sonnet
        LLM_AGENT_TEMPERATURE: "0.7"
        LLM_AGENT_MAX_TOKENS: "2000"
        
        # MCP Connection
        # Name of the destination in BTP Cockpit pointing to the ABAP system
        LLM_AGENT_MCP_DESTINATION: "ABAP_SYSTEM_DESTINATION_NAME"
        
        # Optional: Override MCP Endpoint (usually auto-detected)
        # LLM_AGENT_MCP_ENDPOINT: "https://..."
