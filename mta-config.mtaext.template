_schema-version: "3.3.0"
ID: cloud-llm-hub.config
extends: cloud-llm-hub

modules:
  - name: cloud-llm-hub-srv
    parameters:
      env:
        # LLM Configuration
        LLM_AGENT_MODEL: "anthropic--claude-4.6-sonnet"
        LLM_AGENT_TEMPERATURE: "0.7"
        LLM_AGENT_MAX_TOKENS: "2000"

        # MCP Connection
        # Name of the destination in BTP Cockpit pointing to the ABAP system
        LLM_AGENT_MCP_DESTINATION: "ABAP_SYSTEM_DESTINATION_NAME"

        # SmartAgent Configuration
        LLM_AGENT_MODE: "smart"           # 'smart' | 'pass' | 'hard'
        LLM_AGENT_MAX_ITERATIONS: "10"    # max tool loop iterations
        LLM_AGENT_RAG_TYPE: "in-memory"
        # LLM_AGENT_RESOURCE_GROUP: "default"

        # Embedding model for RAG semantic search
        LLM_AGENT_EMBEDDING_MODEL: "text-embedding-3-small"

        # Optional: Override MCP Endpoint (usually auto-detected)
        # LLM_AGENT_MCP_ENDPOINT: "https://..."
