# MTA Extension File Template
#
# This is a TEMPLATE file (committed to Git) - NO specific values here!
# Copy this to .mtaext and fill in your actual values.
# .mtaext is in .gitignore and will NOT be committed to Git
#
# Usage:
#   cp .mtaext.template .mtaext
#   # Edit .mtaext with your actual values
#   mbt build -t gen --mtar mta.tar -e .mtaext
#
# Required: Replace all YOUR_* placeholders with actual values

_schema-version: '3.3.0'
ID: cloud-llm-hub-deploy
extends: cloud-llm-hub
version: 1.0.0

parameters:
  # LLM Model Configuration
  # Model name determines which provider SAP AI Core routes to:
  # - 'anthropic--claude-4.6-sonnet' → Anthropic Claude
  # - 'gpt-4o-mini', 'gpt-4o' → OpenAI
  # - 'deepseek-chat' → DeepSeek
  LLM_AGENT_MODEL: YOUR_LLM_MODEL_NAME

  # LLM Parameters
  LLM_AGENT_TEMPERATURE: "0.7"
  LLM_AGENT_MAX_TOKENS: "2000"

  # MCP Configuration
  # Destination name configured in BTP Cockpit (points to ABAP system)
  LLM_AGENT_MCP_DESTINATION: YOUR_MCP_DESTINATION_NAME

  # SmartAgent Configuration
  # Mode: 'smart' (full orchestration), 'pass' (passthrough), 'hard' (tools only)
  LLM_AGENT_MODE: "smart"
  # Max tool loop iterations
  LLM_AGENT_MAX_ITERATIONS: "10"
  # RAG backend: 'in-memory'
  LLM_AGENT_RAG_TYPE: "in-memory"
  # SAP AI Core resource group (optional)
  # LLM_AGENT_RESOURCE_GROUP: "default"

  # Embedding model for RAG semantic search
  LLM_AGENT_EMBEDDING_MODEL: "text-embedding-3-small"

  # Optional: MCP Proxy endpoint (auto-detected if not set)
  # LLM_AGENT_MCP_ENDPOINT: "https://your-app.cfapps.eu10.hana.ondemand.com/mcp/stream/http"
