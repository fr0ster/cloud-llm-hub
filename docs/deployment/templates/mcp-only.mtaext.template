# MCP Only — no LLM agent, pure MCP proxy to SAP systems
# Use case: Connect Cline/Claude Desktop directly to SAP via MCP protocol
#
# Usage:
#   cp docs/deployment/templates/mcp-only.mtaext.template .mtaext
#   # Edit values below
#   npx mbt build && cf deploy mta_archives/cloud-llm-hub_*.mtar -e .mtaext

_schema-version: '3.3.0'
ID: cloud-llm-hub-deploy
extends: cloud-llm-hub
version: 1.0.0

parameters:
  # Hub logging; sap-cloud-sdk=error silences SDK basic-auth warnings.
  LLM_AGENT_LOG_LEVEL: "info"
  LLM_AGENT_LOG_LEVELS: "sap-cloud-sdk=error"
  # MCP Configuration — SAP system destination(s)
  LLM_AGENT_MCP_DESTINATION: "S4HANA_DEV"        # BTP destination name

  # System-to-destination mapping (optional, for multi-system routing)
  # DESTINATION_MAPPING: "DEV.100=S4HANA_DEV,QAS.600=S4HANA_QAS"

  # RAG providers (spec §3) — empty/commented = today's behaviour.
  # LLM_AGENT_EMBEDDER: ""
  # LLM_AGENT_EMBEDDER_URL: ""
  # LLM_AGENT_TOOLS_RAG_BACKEND: ""
  # LLM_AGENT_SESSION_RAG_BACKEND: ""
  # LLM_AGENT_RAG_BACKEND: ""
  # LLM_AGENT_QDRANT_URL: ""
  # LLM_AGENT_QDRANT_PREFIX: ""
  # LLM_AGENT_HANA_SERVICE: ""
  # LLM_AGENT_PG_URL: ""
  # LLM_AGENT_PG_SCHEMA: ""
  # LLM_AGENT_DESTINATION_SOURCE: ""

  # Long sessions (see docs/llm-agent/CONFIG_USAGE.md) — empty/commented = defaults.
  # LLM_AGENT_SESSION_TTL_MS: ""
  # LLM_AGENT_SESSION_STORE: ""
  # LLM_AGENT_PLAIN_API: ""
  # LLM_AGENT_PLAIN_MCP: ""

  # Approuter route host: <subaccount subdomain>-cloud-llm-hub (the approuter
  # takes the xsuaa tenant from it; tools/deploy.sh checks)
  APPROUTER_HOST: "<subaccount-subdomain>-cloud-llm-hub"
  # CF_LANDSCAPE: "cfapps.eu10.hana.ondemand.com"   # required: your subaccount's CF landscape

resources:
  - name: cloud-llm-hub-ai-core
    active: false

  # Persistent RAG on HANA (optional): activate the HDI resource and point it at an
  # existing HDI container that holds the RAG tables (tools/deploy-hdi-tables.sh).
  # The resource type is fixed in mta.yaml (existing service); only `active` and
  # `service-name` are set here. To use it, uncomment these lines (they continue the
  # `resources:` list above) and put your container's service instance name.
  # - name: cloud-llm-hub-hdi
  #   active: true
  #   parameters: { service-name: "hdi-llm" }
