# MCP + OpenAI-compatible API — works with OpenAI, Azure OpenAI, Ollama, vLLM
# Use case: SmartAgent without SAP AI Core, using any OpenAI-compatible endpoint
# Requires: API key and base URL for your LLM provider
#
# Usage:
#   cp docs/deployment/templates/mcp-openai.mtaext.template .mtaext
#   # Edit values below (model, destination)
#   npx mbt build && cf deploy mta_archives/cloud-llm-hub_*.mtar -e .mtaext

_schema-version: '3.3.0'
ID: cloud-llm-hub-deploy
extends: cloud-llm-hub
version: 1.0.0

parameters:
  # LLM Provider
  LLM_AGENT_PROVIDER: "openai"

  # NOTE: LLM_AGENT_API_KEY and LLM_AGENT_BASE_URL are deliberately NOT set here.
  # mta.yaml does not declare them, so a value put in this file never reaches the
  # container — and a secret does not belong in a committed extension descriptor.
  # Set them after deploying:
  #   cf set-env cloud-llm-hub-srv LLM_AGENT_API_KEY "<your-api-key>"
  #   cf set-env cloud-llm-hub-srv LLM_AGENT_BASE_URL "<your-base-url>"
  #   cf restart cloud-llm-hub-srv

  # LLM Model Configuration
  LLM_AGENT_MODEL: "gpt-4o"
  LLM_AGENT_TEMPERATURE: "0.7"
  LLM_AGENT_MAX_TOKENS: "32000"

  # MCP Configuration — SAP system destination(s)
  LLM_AGENT_MCP_DESTINATION: "S4HANA_DEV"

  # SmartAgent Configuration
  LLM_AGENT_MODE: "smart"
  LLM_AGENT_MAX_ITERATIONS: "20"
  LLM_AGENT_RAG_TYPE: "vector"

  # Handler sets to expose

  # History recency window
  LLM_AGENT_HISTORY_RECENCY_WINDOW: "20"

  # Approuter route host (unique subdomain for this deployment)
  APPROUTER_HOST: "cloud-llm-hub"

resources:
  - name: cloud-llm-hub-ai-core
    active: false
