# MCP + SAP AI Core — full SmartAgent with SAP AI Core Orchestration
# Use case: Chat UI, OpenAI/Anthropic API endpoints, RAG, tool vectorization
# Requires: SAP AI Core service binding with deployed models
#
# Usage:
#   cp docs/deployment/templates/mcp-sap-ai-core.mtaext.template .mtaext
#   # Edit values below
#   npx mbt build && cf deploy mta_archives/cloud-llm-hub_*.mtar -e .mtaext

_schema-version: '3.3.0'
ID: cloud-llm-hub-deploy
extends: cloud-llm-hub
version: 1.0.0

parameters:
  # LLM_AGENT_CONTEXT_CAPTURE: full
  # LLM_AGENT_CONTEXT_CAPTURE_FILE: context.sqlite
  # LLM_AGENT_CONTEXT_CAPTURE_MAX_MB: 512
  # Optional test markers only; enable LLM_AGENT_CONTEXT_CAPTURE: stats.
  # LLM_AGENT_CONTEXT_CANARY: "SESSION-TAG: [A-Z0-9-]+"
  # Hub logging; sap-cloud-sdk=error silences SDK basic-auth warnings.
  LLM_AGENT_LOG_LEVEL: "info"
  LLM_AGENT_LOG_LEVELS: "sap-cloud-sdk=error"
  # LLM Model Configuration
  LLM_AGENT_MODEL: "anthropic--claude-4.5-sonnet"  # Model deployed in AI Launchpad
  # Unset uses the provider/model default; set a number to override; off explicitly omits.
  LLM_AGENT_TEMPERATURE: ""
  LLM_AGENT_MAX_TOKENS: "32000"

  # MCP Configuration — SAP system destination(s)
  LLM_AGENT_MCP_DESTINATION: "S4HANA_DEV"

  # SmartAgent Configuration
  LLM_AGENT_MODE: "smart"
  LLM_AGENT_MAX_ITERATIONS: "20"
  LLM_AGENT_CHAT_COORDINATOR: "adaptive"
  LLM_AGENT_DIALOGUE_EXECUTORS: "3"
  # Opt-in hub-wide cap across all sessions; empty = per-session queues only.
  LLM_AGENT_DIALOGUE_EXECUTOR_POOL: ""
  LLM_AGENT_DIALOGUE_MAX_TASKS: "50"
  LLM_AGENT_PLAN_MAX_STEPS: ""
  LLM_AGENT_PLAN_MAX_REVISIONS: ""
  LLM_AGENT_PLAN_MAX_DURATION_MS: ""
  LLM_AGENT_RAG_TYPE: "vector"
  # LLM_AGENT_RESOURCE_GROUP: "default"

  # Classifier model (cheaper model for classification and tool-query translation)
  LLM_AGENT_CLASSIFIER_MODEL: "gpt-4.1-mini"

  # Embedding model for RAG semantic search
  LLM_AGENT_EMBEDDING_MODEL: "text-embedding-3-small"


  # Client-managed history recency; server-managed history uses semantic RAG only
  LLM_AGENT_HISTORY_RECENCY_WINDOW: "20"

  # System-to-destination mapping (optional, for multi-system routing)
  DESTINATION_MAPPING: "DEV.100=S4HANA_DEV"

  # RAG providers (spec §3) — empty/commented = today's behaviour.
  # LLM_AGENT_EMBEDDER: ""
  # LLM_AGENT_EMBEDDER_URL: ""
  # LLM_AGENT_TOOLS_RAG_BACKEND: ""
  # LLM_AGENT_SESSION_RAG_BACKEND: ""
  # LLM_AGENT_RAG_BACKEND: ""
  # LLM_AGENT_QDRANT_URL: ""
  # LLM_AGENT_QDRANT_PREFIX: ""
  # LLM_AGENT_HANA_SERVICE: ""
  # LLM_AGENT_PG_URL: ""
  # LLM_AGENT_PG_SCHEMA: ""
  # LLM_AGENT_DESTINATION_SOURCE: ""

  # Long sessions (see docs/llm-agent/CONFIG_USAGE.md) — empty/commented = defaults.
  # LLM_AGENT_SESSION_TTL_MS: ""
  # LLM_AGENT_SESSION_STORE: ""
  # LLM_AGENT_PLAIN_API: ""
  # LLM_AGENT_PLAIN_MCP: ""

  # Approuter route host: <subaccount subdomain>-cloud-llm-hub (the approuter
  # takes the xsuaa tenant from it; tools/deploy.sh checks)
  APPROUTER_HOST: "<subaccount-subdomain>-cloud-llm-hub"
  # CF_LANDSCAPE: "cfapps.eu10.hana.ondemand.com"   # required: your subaccount's CF landscape

resources:
  - name: cloud-llm-hub-ai-core
    active: true

  # Persistent RAG on HANA (optional): activate the HDI resource and point it at an
  # existing HDI container that holds the RAG tables (tools/deploy-hdi-tables.sh).
  # The resource type is fixed in mta.yaml (existing service); only `active` and
  # `service-name` are set here. To use it, uncomment these lines (they continue the
  # `resources:` list above) and put your container's service instance name.
  # - name: cloud-llm-hub-hdi
  #   active: true
  #   parameters: { service-name: "hdi-llm" }

