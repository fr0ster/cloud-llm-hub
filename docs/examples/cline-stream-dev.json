{
  "mcpServers": {
    "cloud-llm-hub-stream": {
      "type": "stream-http",
      "endpoint": "http://localhost:4004/mcp/stream/http",
      "headers": {
        "authorization": "Basic YWxpY2U6",
        "content-type": "application/x-ndjson",
        "x-sap-url": "https://YOUR_SYSTEM.abap.cloud.sap",
        "x-sap-auth-type": "jwt",
        "x-sap-jwt-token": "YOUR_ACCESS_TOKEN_HERE",
        "x-sap-refresh-token": "YOUR_REFRESH_TOKEN_HERE"
      },
      "description": "MCP Proxy Stream-HTTP endpoint (development mode). UAA credentials (uaaUrl, clientId, clientSecret) are stored in server .env file and not needed in headers."
    }
  }
}
