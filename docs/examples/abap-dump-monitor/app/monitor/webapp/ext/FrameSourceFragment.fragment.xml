<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:codeeditor="sap.ui.codeeditor">
  <l:VerticalLayout class="sapUiSmallMargin" width="100%">
    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
      <Label text="Frame:" class="sapUiTinyMarginEnd"/>
      <ComboBox
        id="frameSelect"
        width="40rem"
        placeholder="Select a call-stack frame to load its source"
        items="{path: 'callStack', sorter: { path: 'position', descending: true }}">
        <core:Item
          key="{position}"
          text="{= 'Frame ' + ${position} + ' — ' + (${eventType} || '') + ' ' + (${eventName} || '') + ' @ ' + (${program} || '') + ':' + (${line} || '?')}"/>
      </ComboBox>
    </HBox>
    <MessageStrip
      visible="{= !!${frame>/error}}"
      type="Error"
      showIcon="true"
      text="{frame>/error}"
      class="sapUiSmallMarginBottom"/>
    <BusyIndicator visible="{frame>/busy}" class="sapUiSmallMargin"/>
    <codeeditor:CodeEditor
      visible="{= !!${frame>/source} &amp;&amp; !${frame>/busy}}"
      type="abap"
      editable="false"
      lineNumbers="true"
      width="100%"
      height="500px"
      value="{frame>/source}"/>
  </l:VerticalLayout>
</core:FragmentDefinition>
