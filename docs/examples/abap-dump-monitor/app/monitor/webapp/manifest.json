{
  "_version": "1.28.0",
  "sap.app": {
    "id": "monitor",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "MonitorService": {
        "uri": "/odata/v4/admin/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "MonitoredDump-display": {
          "signature": {
            "parameters": {},
            "additionalParameters": "ignored"
          },
          "semanticObject": "MonitoredDump",
          "action": "display",
          "title": "{{appTitle}}",
          "info": "{{appDescription}}",
          "icon": "sap-icon://alert",
          "indicatorDataSource": {
            "dataSource": "MonitorService",
            "path": "MonitoredDump/$count",
            "refresh": 600
          }
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.fe.templates": {},
        "sap.ui.codeeditor": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      },
      "": {
        "dataSource": "MonitorService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MonitoredDumpList",
          "target": "MonitoredDumpList"
        },
        {
          "pattern": "MonitoredDump({key}):?query:",
          "name": "MonitoredDumpDetails",
          "target": "MonitoredDumpDetails"
        }
      ],
      "targets": {
        "MonitoredDumpList": {
          "type": "Component",
          "id": "MonitoredDumpList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "MonitoredDump",
              "liveMode": true,
              "navigation": {
                "MonitoredDump": {
                  "detail": {
                    "route": "MonitoredDumpDetails"
                  }
                }
              }
            }
          }
        },
        "MonitoredDumpDetails": {
          "type": "Component",
          "id": "MonitoredDumpDetailsList",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "MonitoredDump",
              "content": {
                "body": {
                  "sections": {
                    "SourceCode": {
                      "type": "XMLFragment",
                      "title": "Source",
                      "template": "monitor.ext.SourceFragment",
                      "requestAtLeast": "sourceExtract/code,sourceExtract/program,sourceExtract/include,sourceExtract/lineFrom,sourceExtract/lineTo",
                      "position": { "placement": "After", "anchor": "Stack" }
                    },
                    "AnalysisCustom": {
                      "type": "XMLFragment",
                      "title": "Analysis",
                      "template": "monitor.ext.AnalysisFragment",
                      "requestAtLeast": "analysisStatus,analysisAttempts,analysisError,recommendations,recommendationsHtml",
                      "position": { "placement": "After", "anchor": "Refs" }
                    },
                    "JiraCustom": {
                      "type": "XMLFragment",
                      "title": "Jira",
                      "template": "monitor.ext.JiraFragment",
                      "requestAtLeast": "jiraStatus,jiraAttempts,jiraError,jiraIssueKey,jiraIssueUrl,skipJira",
                      "position": { "placement": "After", "anchor": "AnalysisCustom" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
