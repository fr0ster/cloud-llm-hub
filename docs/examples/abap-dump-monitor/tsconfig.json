{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "gen/srv",
    "rootDir": ".",
    "declaration": false,
    "noEmit": false
  },
  "include": ["srv/**/*", "test/**/*"]
}
