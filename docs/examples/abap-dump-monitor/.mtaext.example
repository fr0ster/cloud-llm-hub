_schema-version: 3.3.0
ID: abap-dump-monitor.config
extends: abap-dump-monitor

parameters:
  # Approuter host — must be unique per CF landscape. Convention:
  # "<subaccount-subdomain>-abap-dump-monitor". bin/deploy.sh derives this
  # automatically from the targeted CF org name.
  APPROUTER_HOST: "<subaccount-subdomain>-abap-dump-monitor"

  # cloud-llm-hub OAuth2ClientCredentials — fetch from `cloud-llm-hub-analyst-consumer` service key
  CLOUD_LLM_HUB_URL: "https://cloud-llm-hub-srv.cfapps.eu10-004.hana.ondemand.com"
  CLOUD_LLM_HUB_CLIENT_ID: "sb-..."
  CLOUD_LLM_HUB_CLIENT_SECRET: "..."
  CLOUD_LLM_HUB_TOKEN_URL: "https://<subaccount>.authentication.eu10-004.hana.ondemand.com/oauth/token"

  # Jira base URL (used to render clickable issue links in the Object Page).
  # Credentials are NOT in .mtaext — create the JIRA_EPAM destination once
  # in the BTP cockpit (subaccount-level) with your Personal Access Token.
  # Redeploys do not overwrite it.
  JIRA_URL: "https://jiraeu.epam.com"

modules:
  - name: abap-dump-monitor-srv
    properties:
      SAP_SYSTEM_ID: "E19.100"        # logical system stored in MonitoredDump.system/signature
      SAP_DESTINATION: "S4HANA_E19"   # BTP destination sent as X-SAP-Destination
