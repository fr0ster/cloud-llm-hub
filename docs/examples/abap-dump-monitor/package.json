{
  "name": "abap-dump-monitor",
  "version": "1.0.0",
  "description": "CAP example: scheduled-pull ABAP dump monitor via cloud-llm-hub + Jira",
  "main": "gen/srv/srv/server.js",
  "scripts": {
    "start": "cds-serve",
    "build": "cds build --production",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "npx biome check --write .",
    "lint:check": "npx biome check ."
  },
  "dependencies": {
    "@cap-js/sqlite": "2.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@sap/cds-dk": "^9",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.2",
    "jest": "^30.4.1",
    "ts-jest": "^29",
    "typescript": "^6.0.3"
  },
  "cds": {
    "requires": {
      "auth": {
        "[production]": {
          "kind": "xsuaa"
        },
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": {
              "roles": [
                "Admin",
                "Viewer"
              ]
            },
            "viewer": {
              "roles": [
                "Viewer"
              ]
            }
          }
        }
      },
      "db": {
        "[production]": {
          "kind": "sqlite",
          "credentials": {
            "url": "/home/vcap/app/db/abap-dump-monitor.sqlite"
          }
        },
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      }
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/unit/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/gen/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/gen/"
    ]
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "unrs-resolver@1.12.2": true
  }
}
