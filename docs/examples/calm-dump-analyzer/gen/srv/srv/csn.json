{
  "definitions": {
    "AnalyzerService": {
      "@source": "srv/analyzer-service.cds",
      "kind": "service",
      "@path": "analyzer"
    },
    "AnalyzerService.AnalyzeDump": {
      "kind": "action",
      "params": {
        "event": {
          "type": "cds.LargeString"
        }
      },
      "returns": {
        "type": "AnalysisResult"
      }
    },
    "AnalyzerService.Health": {
      "kind": "function",
      "returns": {
        "type": "HealthStatus"
      }
    },
    "AnalysisResult": {
      "kind": "type",
      "elements": {
        "status": {
          "type": "cds.String"
        },
        "system": {
          "type": "cds.String"
        },
        "program": {
          "type": "cds.String"
        },
        "error": {
          "type": "cds.String"
        },
        "exception": {
          "type": "cds.String"
        },
        "user": {
          "type": "cds.String"
        },
        "rootCause": {
          "type": "cds.String"
        },
        "codeSection": {
          "type": "cds.String"
        },
        "severity": {
          "type": "cds.String"
        },
        "recommendations": {
          "type": "cds.LargeString"
        },
        "errorMessage": {
          "type": "cds.String"
        }
      }
    },
    "HealthStatus": {
      "kind": "type",
      "elements": {
        "status": {
          "type": "cds.String"
        },
        "llmHubUrl": {
          "type": "cds.String"
        },
        "timestamp": {
          "type": "cds.DateTime"
        }
      }
    },
    "cds.outbox.Messages": {
      "kind": "entity",
      "elements": {
        "ID": {
          "key": true,
          "type": "cds.UUID"
        },
        "timestamp": {
          "type": "cds.Timestamp"
        },
        "target": {
          "type": "cds.String"
        },
        "msg": {
          "type": "cds.LargeString"
        },
        "attempts": {
          "type": "cds.Integer",
          "default": {
            "val": 0
          }
        },
        "partition": {
          "type": "cds.Integer",
          "default": {
            "val": 0
          }
        },
        "lastError": {
          "type": "cds.LargeString"
        },
        "lastAttemptTimestamp": {
          "type": "cds.Timestamp"
        },
        "status": {
          "type": "cds.String",
          "length": 23
        },
        "task": {
          "type": "cds.String",
          "length": 255
        },
        "appid": {
          "type": "cds.String",
          "length": 255
        }
      }
    }
  },
  "meta": {
    "creator": "CDS Compiler v6.8.0",
    "compilerCsnFlavor": "inferred",
    "flavor": "inferred"
  },
  "$version": "2.0"
}