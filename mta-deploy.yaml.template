# MTA Deployment Parameters Template
#
# This is a TEMPLATE file (committed to Git) - NO specific values here!
# Copy this to mta-deploy.yaml and fill in your actual values.
# mta-deploy.yaml is in .gitignore and will NOT be committed to Git
#
# Usage:
#   cp mta-deploy.yaml.template mta-deploy.yaml
#   # Edit mta-deploy.yaml with your actual values
#   npm run deploy
#
# Required Variables:
#   - LLM_AGENT_MODEL: Model name (e.g., 'gpt-4o-mini', 'claude-3-5-sonnet', 'deepseek-chat')
#   - LLM_AGENT_TEMPERATURE: Temperature (0.0 - 2.0, default: 0.7)
#   - LLM_AGENT_MAX_TOKENS: Maximum tokens in response (default: 2000)
#   - LLM_AGENT_MCP_DESTINATION: Destination name for MCP/ABAP connection
#
# Optional Variables:
#   - LLM_AGENT_MCP_ENDPOINT: MCP proxy endpoint URL (auto-detected if not set)

LLM_AGENT_MODEL: "YOUR_LLM_MODEL_NAME"
LLM_AGENT_TEMPERATURE: "0.7"
LLM_AGENT_MAX_TOKENS: "2000"
LLM_AGENT_MCP_DESTINATION: "YOUR_MCP_DESTINATION_NAME"
# LLM_AGENT_MCP_ENDPOINT: "https://your-app.cfapps.eu10.hana.ondemand.com/mcp/stream/http"
