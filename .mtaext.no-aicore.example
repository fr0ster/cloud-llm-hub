_schema-version: '3.3.0'
ID: cloud-llm-hub-no-aicore
extends: cloud-llm-hub
version: 1.0.0

parameters:
  # LLM Model Configuration
  LLM_AGENT_MODEL: "anthropic--claude-4.6-sonnet"
  LLM_AGENT_TEMPERATURE: "0.7"
  LLM_AGENT_MAX_TOKENS: "32000"
  LLM_AGENT_MCP_DESTINATION: "MY_ABAP_SYSTEM"
  LLM_AGENT_MODE: "smart"
  LLM_AGENT_MAX_ITERATIONS: "10"

  # AI Core credentials (no service binding — provide explicitly)
  AICORE_AUTH_URL: "https://your-tenant.authentication.eu10.hana.ondemand.com"
  AICORE_CLIENT_ID: "sb-your-client-id"
  AICORE_CLIENT_SECRET: "your-client-secret"
  AICORE_BASE_URL: "https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com"

# AI Core resource stays inactive (default from mta.yaml)
