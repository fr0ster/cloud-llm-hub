{
  "name": "cloud-llm-hub",
  "version": "1.3.2",
  "description": "A simple CAP project.",
  "dependencies": {
    "@mcp-abap-adt/llm-proxy": "^0.0.1",
    "@mcp-abap-adt/adt-clients": "^3.10.2",
    "@mcp-abap-adt/auth-broker": "^1.0.5",
    "@mcp-abap-adt/connection": "^1.5.0",
    "@mcp-abap-adt/core": "^4.2.1",
    "@mcp-abap-adt/header-validator": "^0.1.8",
    "@mcp-abap-adt/interfaces": "^3.1.0",
    "@mcp-abap-adt/logger": "^0.1.4",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4.4.0",
    "@sap/cds": "^9.7.1",
    "@sap/xsenv": "^6.1.0",
    "@sap/xssec": "^4.12.2",
    "axios": "^1.13.5",
    "dotenv": "^17.2.4",
    "express": "^4",
    "https-proxy-agent": "^7.0.2",
    "js-yaml": "^4.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^2.3.15",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.16.0",
    "@cap-js/sqlite": "^2.1.3",
    "@sap/cds-dk": "^9.7.1",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4",
    "typescript": "^5"
  },
  "scripts": {
    "start": "cds-serve",
    "start:log": "bash tools/start-debug.sh",
    "test": "node test/test-cap-from-yaml.js --config test/integration.yaml",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:check": "npx tsc --noEmit",
    "lint": "npx biome check --write --config-path . srv tools test",
    "lint:check": "npx biome check --config-path . srv tools test",
    "format": "npx biome format --write --config-path . srv tools test",
    "build": "npx cds b",
    "build:mta": "npx mbt build -t gen/mta_archives --mtar cloud-llm-hub.tar",
    "deploy": "cf deploy gen/mta_archives/cloud-llm-hub.tar --abort-on-error --delete-services",
    "cf-env": "cf e cloud-llm-hub-srv",
    "get:key": "node tools/get-mcp-service-key.js",
    "update:cline": "node tools/update-cline-connection.js",
    "update:cline:yaml": "node tools/update-cline-connection.js",
    "update:env": "node tools/update-default-env.js",
    "sync:version": "node tools/sync-version.js",
    "bump:version": "node tools/bump-version.js",
    "version": "node tools/sync-version.js && git add mta.yaml"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10"
  },
  "cds": {
    "watch": {
      "ignore": [
        ".git/**",
        "node_modules/**",
        "dist/**",
        "gen/**",
        ".DS_Store",
        "*.log"
      ]
    },
    "requires": {
      "auth": {
        "kind": "xsuaa",
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "MCP_Connector",
                "MCP_Admin"
              ]
            },
            "bob": {
              "roles": [
                "MCP_Connector"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        },
        "passport": {
          "strategy": "JWT"
        }
      },
      "mcpTarget": {
        "kind": "rest",
        "credentials": {
          "url": "http://127.0.0.1:7070"
        }
      }
    }
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "volta": {
    "node": "22.16.0"
  }
}
