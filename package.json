{
  "name": "cloud-llm-hub",
  "version": "1.1.3",
  "description": "A simple CAP project.",
  "dependencies": {
    "@fr0ster/mcp-abap-adt": "file:submodules/mcp-abap-adt",
    "@mcp-abap-adt/adt-clients": "^0.2.6",
    "@mcp-abap-adt/auth-broker": "^0.2.10",
    "@mcp-abap-adt/connection": "^0.2.5",
    "@mcp-abap-adt/header-validator": "^0.1.8",
    "@mcp-abap-adt/interfaces": "^0.2.7",
    "@mcp-abap-adt/logger": "^0.1.4",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4.1.2",
    "@sap/cds": "^9",
    "@sap/xsenv": "^4",
    "@sap/xssec": "^4",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4",
    "https-proxy-agent": "^7.0.2",
    "js-yaml": "^4.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@types/express": "^5.0.5",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.3",
    "tsx": "^4",
    "typescript": "^5"
  },
  "scripts": {
    "start": "cds-serve",
    "start:log": "bash tools/start-debug.sh",
    "test": "node test/test-cap-from-yaml.js --config test/integration.yaml",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.js,.mjs",
    "lint:fix": "eslint . --ext .ts,.js,.mjs --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md}\"",
    "update:cline": "node tools/update-cline-connection.js",
    "update:cline:yaml": "node tools/update-cline-connection.js",
    "copy:mcp-submodule": "node tools/copy-mcp-submodule.js",
    "update:env": "node tools/update-default-env.js",
    "sync:version": "node tools/sync-version.js",
    "bump:version": "node tools/bump-version.js",
    "version": "node tools/sync-version.js && git add mta.yaml"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "cds": {
    "watch": {
      "ignore": [
        ".git/**",
        "node_modules/**",
        "dist/**",
        "gen/**",
        ".DS_Store",
        "*.log"
      ]
    },
    "requires": {
      "auth": {
        "kind": "xsuaa",
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "MCP_Connector",
                "MCP_Admin"
              ]
            },
            "bob": {
              "roles": [
                "MCP_Connector"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        },
        "passport": {
          "strategy": "JWT"
        }
      },
      "mcpTarget": {
        "kind": "rest",
        "credentials": {
          "url": "http://127.0.0.1:7070"
        }
      }
    }
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}
