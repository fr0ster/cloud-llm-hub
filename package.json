{
  "name": "cloud-llm-hub",
  "version": "6.35.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@mcp-abap-adt/anthropic-llm": "^30.0.0",
    "@mcp-abap-adt/auth-broker": "^3.0.4",
    "@mcp-abap-adt/connection": "^9.4.2",
    "@mcp-abap-adt/deepseek-llm": "^30.0.0",
    "@mcp-abap-adt/header-validator": "^0.3.1",
    "@mcp-abap-adt/interfaces-adt-connection": "^1.0.0",
    "@mcp-abap-adt/interfaces-auth": "^2.1.0",
    "@mcp-abap-adt/interfaces-network": "^2.0.0",
    "@mcp-abap-adt/interfaces-utils": "^1.1.0",
    "@mcp-abap-adt/lib": "^14.1.1",
    "@mcp-abap-adt/llm-agent": "^30.0.0",
    "@mcp-abap-adt/llm-agent-libs": "^30.0.0",
    "@mcp-abap-adt/llm-agent-mcp": "^30.0.0",
    "@mcp-abap-adt/llm-agent-rag": "^30.0.0",
    "@mcp-abap-adt/logger": "^0.4.1",
    "@mcp-abap-adt/ollama-embedder": "^30.0.0",
    "@mcp-abap-adt/openai-embedder": "^30.0.0",
    "@mcp-abap-adt/openai-llm": "^30.0.0",
    "@mcp-abap-adt/qdrant-rag": "^30.0.0",
    "@mcp-abap-adt/sap-aicore-auth": "^30.0.0",
    "@mcp-abap-adt/sap-aicore-embedder": "^30.0.0",
    "@mcp-abap-adt/sap-aicore-llm": "^30.0.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@sap-ai-sdk/orchestration": "^2.10.0",
    "@sap-cloud-sdk/connectivity": "^4.6.0",
    "@sap-cloud-sdk/http-client": "^4.6.0",
    "@sap/cds": "^10.1.0",
    "@sap/xsenv": "^6.2.2",
    "@sap/xssec": "^4.15.0",
    "axios": "^1.16.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "js-yaml": "^5.4.2",
    "node-fetch": "^3.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3.1.0",
    "@mcp-abap-adt/proxy": "^5.0.3",
    "@sap/cds-dk": "^10.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "husky": "^9.1.7",
    "jest": "^30.4.0",
    "mbt": "1.2.49",
    "ts-jest": "^29.4.9",
    "tsx": "^4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "cds-serve",
    "start:log": "bash tools/start-debug.sh",
    "dev:local": "node tools/dev-local.js",
    "test": "node test/test-cap-from-yaml.js --config test/integration.yaml",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:integration": "jest --testMatch='**/test/integration/**/*.test.ts'",
    "test:check": "npx tsc --noEmit",
    "lint": "npx biome check --write --config-path . srv tools test",
    "lint:check": "npx biome check --config-path . srv tools test",
    "docs:check": "node tools/check-docs.js",
    "format": "npx biome format --write --config-path . srv tools test",
    "build": "npx cds b",
    "build:mta": "npx mbt build -t gen/mta_archives --mtar cloud-llm-hub.mtar",
    "deploy": "cf deploy gen/mta_archives/cloud-llm-hub.mtar -e .mtaext --abort-on-error --delete-services -f",
    "cf-env": "cf e cloud-llm-hub-srv",
    "get:key": "node tools/get-mcp-service-key.js",
    "proxy": "bash scripts/start-proxy.sh",
    "get:token": "npx mcp-auth --service-key ./mcp.json --output ./service.env --type xsuaa",
    "update:cline": "node tools/update-cline-connection.js",
    "update:cline:yaml": "node tools/update-cline-connection.js",
    "update:env": "node tools/update-default-env.js",
    "verify:setup": "node tools/verify-cross-platform-setup.js",
    "deploy:set-env": "node tools/set-btp-env.js",
    "generate:intents": "npx tsx tools/generate-tool-intents.ts",
    "sync:version": "node tools/sync-version.js",
    "gen:tool-exposition": "npx tsx tools/generate-tool-exposition.ts",
    "bump:version": "node tools/bump-version.js",
    "version": "node tools/sync-version.js && git add mta.yaml",
    "prepare": "husky || true"
  },
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10"
  },
  "cds": {
    "watch": {
      "ignore": [
        ".git/**",
        "node_modules/**",
        "dist/**",
        "gen/**",
        ".DS_Store",
        "*.log"
      ]
    },
    "log": {
      "mask_headers": [
        "/authorization/i",
        "/cookie/i",
        "/cert/i",
        "/ssl/i",
        "/x-sap-password/i",
        "/x-sap-login/i"
      ]
    },
    "requires": {
      "auth": {
        "kind": "xsuaa",
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "MCP_Full",
                "MCP_Developer",
                "MCP_Analyst",
                "MCP_Reader"
              ]
            },
            "bob": {
              "roles": [
                "MCP_Developer",
                "MCP_Analyst",
                "MCP_Reader"
              ]
            },
            "carol": {
              "roles": [
                "MCP_Analyst",
                "MCP_Reader"
              ]
            },
            "dave": {
              "roles": [
                "MCP_Reader"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        },
        "passport": {
          "strategy": "JWT"
        }
      },
      "mcpTarget": {
        "kind": "rest",
        "credentials": {
          "url": "http://127.0.0.1:7070"
        }
      }
    }
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "volta": {
    "node": "22.16.0"
  }
}
