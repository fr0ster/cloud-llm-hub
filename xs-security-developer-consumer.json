{
  "xsappname": "cloud-llm-hub-developer-consumer-{space-guid}",
  "tenant-mode": "shared",
  "scopes": [],
  "authorities": [
    "$ACCEPT_GRANTED_AUTHORITIES"
  ],
  "oauth2-configuration": {
    "credential-types": [
      "binding-secret",
      "x509"
    ],
    "grant-types": [
      "client_credentials"
    ],
    "token-validity": 86400,
    "refresh-token-validity": 2592000
  }
}
