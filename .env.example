# Cloud LLM Hub - Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is in .gitignore and will NOT be committed to Git

# ==========================================
# Local MCP Development (cds watch)
# ==========================================

# SAP ABAP system connection (for local MCP testing)
# Obtain via: npm run get:key && npx mcp-auth --service-key ./mcp.json --output ./abap.env --type abap
# SAP_URL=https://your-abap-system.hana.ondemand.com
# SAP_AUTH_TYPE=jwt
# SAP_JWT_TOKEN=your_jwt_token_here
# SAP_REFRESH_TOKEN=your_refresh_token_here
# SAP_UAA_URL=https://your-tenant.authentication.region.hana.ondemand.com
# SAP_UAA_CLIENT_ID=your_client_id
# SAP_UAA_CLIENT_SECRET=your_client_secret

# ==========================================
# Cloud Smoke Tests
# ==========================================
#
# Quick setup (recommended):
#   1. npm run get:key          # CF service key -> mcp.json
#   2. npm run get:token        # Browser auth -> service.env (XSUAA_JWT_TOKEN)
#   3. ./test/smoke/test-cloud-endpoints.sh <base-url>
#
# Manual setup:
#   Set TEST_JWT_XSUAA below (obtain via: cf oauth-token | sed 's/bearer //')

# Base URL of the deployed cloud-llm-hub-srv app
# TEST_BASE_URL=https://your-app.cfapps.eu10.hana.ondemand.com

# XSUAA JWT token (manual override, takes priority over service.env)
# TEST_JWT_XSUAA=your_xsuaa_jwt_token_here

# MCP destination name (must be configured in BTP Cockpit)
# TEST_MCP_DESTINATION=SAP_ABAP_TRIAL

# ==========================================
# Deploy Worktree Secrets (.worktrees/<env>/.env)
# ==========================================
#
# Each deploy worktree needs .env with secrets that cannot go in .mtaext.
# These are injected via cf set-env after deploy (deploy.sh handles this).
#
# AI Core credentials (when no aicore service binding in the subaccount):
# Get from subaccount that owns AI Core: cf env cloud-llm-hub-srv | grep aicore
# Or: npm run update:env → extract from default-env.json
# AICORE_AUTH_URL=https://<subaccount>.authentication.<region>.hana.ondemand.com
# AICORE_CLIENT_ID=sb-<guid>|aicore!b540
# AICORE_CLIENT_SECRET=<secret>
# AICORE_BASE_URL=https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com
#
# OpenAI API credentials (when provider=openai):
# LLM_AGENT_API_KEY=sk-...
# LLM_AGENT_BASE_URL=https://api.openai.com/v1
